# Normalize text files to LF in the repository
* text=auto eol=lf

# Binary resources
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.zip binary
*.app binary
*.hap binary
*.hsp binary
*.p12 binary
*.p7b binary
*.cer binary
*.jks binary
*.keystore binary

# GitHub language stats: ArkTS (.ets) as TypeScript
entry/**/*.ets linguist-language=TypeScript
entry/**/*.ets linguist-detectable=true
**/*.d.ets linguist-detectable=false
**/build/** linguist-vendored
**/oh_modules/** linguist-vendored
